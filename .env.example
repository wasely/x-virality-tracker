# Compose production template. Copy to .env, replace every placeholder, and never commit .env.
# Direct host execution needs localhost in XV_DATABASE_URL and a host path in XV_RULES_PATH.
# Keep XV_ENVIRONMENT equal to config/rules.example.yml:environment.
XV_ENVIRONMENT=production
XV_DATABASE_URL=postgresql+psycopg://x_virality:replace_with_strong_database_password@postgres:5432/x_virality
XV_BUILD_SHA=replace_with_release_revision
XV_LOG_LEVEL=INFO

# Official X API credentials and limits.
XV_X_BEARER_TOKEN=replace_with_x_bearer_token
XV_X_API_BASE_URL=https://api.x.com
XV_RULES_PATH=/app/config/rules.example.yml
XV_MANAGED_RULE_PREFIX=xv
XV_ENTERPRISE_BACKFILL_ENABLED=false
XV_RECOVERY_BOOTSTRAP_MINUTES=15
XV_RECOVERY_OVERLAP_SECONDS=30
XV_USAGE_SOFT_LIMIT_PERCENT=80

# Dedicated Discord application for X alerts.
XV_DISCORD_BOT_TOKEN=replace_with_discord_bot_token
XV_DISCORD_APPLICATION_ID=replace_with_application_id
XV_DISCORD_PUBLIC_KEY=replace_with_public_key
XV_DISCORD_ALERT_CHANNEL_ID=replace_with_channel_id
XV_DISCORD_COMPONENT_SECRET=replace_with_a_long_random_secret

# Operations API and worker behavior.
XV_ADMIN_TOKEN=replace_with_a_long_random_admin_token
XV_API_HOST=0.0.0.0
XV_API_PORT=8080
XV_HTTP_TIMEOUT_SECONDS=20
XV_STREAM_STALL_SECONDS=90
XV_STREAM_LEASE_SECONDS=45
XV_JOB_LEASE_SECONDS=120
XV_WORKER_CONCURRENCY=8
XV_OUTBOX_CONCURRENCY=2
XV_WORKER_RETRY_BASE_SECONDS=2
XV_WORKER_RETRY_MAX_SECONDS=300
XV_WORKER_SHUTDOWN_GRACE_SECONDS=30
XV_POLL_INTERVAL_SECONDS=1
XV_HEARTBEAT_INTERVAL_SECONDS=15
XV_HEALTH_STALE_SECONDS=90
XV_RETENTION_DAYS=30

# Used by docker-compose.yml only.
XV_HOST_API_PORT=8080
XV_POSTGRES_DB=x_virality
XV_POSTGRES_USER=x_virality
XV_POSTGRES_PASSWORD=replace_with_strong_database_password
